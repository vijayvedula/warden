# Warden configuration via the environment (12-factor, factor III).
#
# Every `warden proxy` option is settable as WARDEN_<OPTION>, where <OPTION> is
# the flag name upper-cased with dashes turned into underscores
# (e.g. --jwks-url  ->  WARDEN_JWKS_URL).
#
# Precedence, highest first:  CLI flag  >  WARDEN_* env  >  --config TOML  >  default
#
# Copy to `.env` and edit. NEVER commit a real `.env` (it is gitignored).

# --- Core proxy ---
WARDEN_UPSTREAM="python3 tools_server.py"   # the real MCP tool server to front
WARDEN_AGENT=prod-agent
WARDEN_POLICY=warden.policy.toml

# --- Backing services (factor IV: attach via config, not code) ---
WARDEN_AUDIT=.warden/audit.jsonl
WARDEN_APPROVALS=.warden/approvals.json
# WARDEN_OCSF=.warden/ocsf.jsonl            # SIEM event sink

# --- Identity / verification (production) ---
# WARDEN_TOKEN=.warden/token.jwt            # session delegation token
# WARDEN_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# WARDEN_ISSUER_URL=https://idp.example.com # OIDC discovery (derives jwks-url)
# WARDEN_AUD=warden:prod
# WARDEN_ISS=https://idp.example.com
# WARDEN_REQUIRE_AT_JWT=true                # RFC 9068 typ enforcement
# WARDEN_REQUEST_IDENTITY=true              # per-request bearer identity (shared gateway)

# --- Evidence / tamper-evidence ---
# WARDEN_ANCHOR=.warden/anchor.jsonl
# WARDEN_ANCHOR_KEY=/run/secrets/anchor.pem # keep signing keys in a secret store

# --- Transport (factor VII: port binding) ---
# WARDEN_HTTP=0.0.0.0:8080                  # HTTP (MCP Streamable-HTTP); omit for stdio
# WARDEN_HTTP_AUTH_TOKEN=/run/secrets/http-auth

# --- Observability (factor XI: logs are an event stream to stdout/stderr) ---
WARDEN_LOG_FORMAT=json

# --- Disposability (factor IX) ---
WARDEN_DRAIN_TIMEOUT=10                      # graceful drain seconds on SIGTERM
